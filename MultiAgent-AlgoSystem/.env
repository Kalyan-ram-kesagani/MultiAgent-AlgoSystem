# Autonomous AI Trading System - Active Environment Configuration
# Explicit Environment Mode: SANDBOX | DEMO | LIVE
ENVIRONMENT=DEMO
DEBUG=true
LOG_LEVEL=INFO

# Backend Server
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=trading_system_secret_key_development_only

# Database
DATABASE_URL=sqlite+aiosqlite:///./trading_platform.db

# MetaTrader 5 Configuration
MT5_PATH="C:\\Program Files\\MetaTrader 5\\terminal64.exe"
