# Autonomous AI Trading System - Environment Configuration
# Explicit Environment Mode: SANDBOX | DEMO | LIVE
ENVIRONMENT=SANDBOX
TRADING_MODE=DEMO
DEBUG=true
LOG_LEVEL=INFO

# AI Agent (OpenAI Agents SDK)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Backend Server
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change_this_in_production_to_a_secure_random_string

# Database
# Default uses local SQLite for instant development; set to PostgreSQL for Docker/production
DATABASE_URL=sqlite+aiosqlite:///./trading_platform.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trading_db

# Redis / Cache (Optional)
REDIS_URL=redis://localhost:6379/0

# MetaTrader 5 Configuration
MT5_PATH="C:\\Program Files\\MetaTrader 5\\terminal64.exe"
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT_MS=60000
MT5_PORTABLE=false

# Safety Gates & Execution Guardrails
LIVE_TRADING_ACKNOWLEDGED=false
MAX_TICK_AGE_SECONDS=10.0
IDEMPOTENCY_WINDOW_SECONDS=30
DEMO_MAX_ORDER_LOTS=0.50

# Risk Engine Thresholds (Hard Defaults)
RISK_PER_TRADE_PCT=0.01
MAX_DAILY_LOSS_PCT=0.03
MAX_WEEKLY_LOSS_PCT=0.06
MAX_ACCOUNT_DRAWDOWN_PCT=0.10
MAX_OPEN_POSITIONS=5
MAX_SYMBOL_EXPOSURE=2
MAX_ALLOWED_SPREAD_PIPS=5.0
MAX_SLIPPAGE_POINTS=20
CONSECUTIVE_LOSS_LIMIT=3

# Kill Switch Defaults
EMERGENCY_KILL_SWITCH_ACTIVE=false
AUTO_KILL_ON_MT5_DISCONNECT=true
